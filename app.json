{
  "expo": {
    "name": "Azqm",
    "slug": "azqm",
    "version": "1.2.0",
    "scheme": "azqm",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E1116",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tanatos.azqm",
      "infoPlist": {
        "NSCameraUsageDescription": "Камерата се използва за сканиране на баркодове и снимане на храна."
      }
    },
    "android": {
      "package": "com.tanatos.azqm",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {}
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Камерата се използва за сканиране на баркодове и снимане на храна.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# expo-camera checks for ML Kit barcode scanning with Class.forName; keep the class under its real name.\n-keep class com.google.mlkit.vision.barcode.BarcodeScanning { *; }"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Manrope_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Manrope_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Manrope_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Manrope_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Manrope_800ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope_400Regular.ttf",
              "./assets/fonts/Manrope_500Medium.ttf",
              "./assets/fonts/Manrope_600SemiBold.ttf",
              "./assets/fonts/Manrope_700Bold.ttf",
              "./assets/fonts/Manrope_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
