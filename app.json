{
  "expo": {
    "name": "Azqm",
    "slug": "azqm",
    "version": "1.5.1",
    "scheme": "azqm",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E1116",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tanatos.azqm",
      "infoPlist": {
        "NSCameraUsageDescription": "Камерата се използва за сканиране на баркодове, снимане на храна и снимки за прогрес."
      }
    },
    "android": {
      "package": "com.tanatos.azqm",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {}
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Камерата се използва за сканиране на баркодове, снимане на храна и снимки за прогрес.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# expo-camera checks for ML Kit barcode scanning with Class.forName; keep the class under its real name.\n-keep class com.google.mlkit.vision.barcode.BarcodeScanning { *; }"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Inter_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Inter_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Inter_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Inter_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Onest",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Onest_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Onest_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Onest_800ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Manrope_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Manrope_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Manrope_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Manrope_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Manrope_800ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Tektur",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Tektur_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Tektur_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Tektur_800ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Montserrat",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Montserrat_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Montserrat_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Montserrat_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Montserrat_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "AzqmSerif",
                "fontDefinitions": [
                  { "path": "./assets/fonts/AzqmSerif_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/AzqmSerif_800ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Unbounded",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Unbounded_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Unbounded_800ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Exo2",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Exo2_400Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Exo2_500Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Exo2_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Exo2_700Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "WixMadeforDisplay",
                "fontDefinitions": [
                  { "path": "./assets/fonts/WixMadeforDisplay_600SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/WixMadeforDisplay_700Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/WixMadeforDisplay_800ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-iap",
        {
          "android": { "store": "play" }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF3F6C"
        }
      ],
      "./plugins/withGradleMemory"
    ],
    "extra": {
      "router": {}
    }
  }
}
